{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "node tools/setup.cjs",
    "new": "node tools/site.cjs new",
    "build": "node tools/site.cjs build",
    "check:posts": "node tools/site.cjs check-posts",
    "check:output": "node tools/site.cjs check-output",
    "test": "node tools/test/post-check.test.cjs && node tools/test/output-check.test.cjs && node tools/test/project.test.cjs",
    "verify": "npm run test && npm run build",
    "config:example": "node tools/config-example.cjs",
    "clean": "node tools/site.cjs clean",
    "deploy": "node tools/site.cjs deploy",
    "server": "hexo server"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "hexo": {
    "version": "6.2.0"
  },
  "dependencies": {
    "gitalk": "^1.7.2",
    "hexo": "^6.2.0",
    "hexo-deployer-cos": "^1.2.1",
    "hexo-deployer-cos-cdn": "^1.7.1",
    "hexo-deployer-git": "^3.0.0",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^2.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-tag": "^1.0.0",
    "hexo-permalink-pinyin": "^1.1.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^5.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-aurora": "^1.5.5",
    "hexo-theme-landscape": "^0.0.3",
    "hexo-wordcount": "^6.0.1"
  }
}
